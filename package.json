    },
    "bugs": {
        "url": "https://github.com/uniweb/semantic-parser/issues"
    },
    "homepage": "https://github.com/uniweb/semantic-parser#readme",
    "directories": {
        "test": "tests"
    },
    "dependencies": {
        "yaml": "^2.8.2"
